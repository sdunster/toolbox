# Copy to .env.local (gitignored). Nothing here is required.

# Cloudflare Turnstile site key. Leave unset (the default) to build without the
# widget, which is what the API expects while it has no TURNSTILE_SECRET_KEY.
# Cloudflare's always-pass test key is 1x00000000000000000000AA.
# VITE_TURNSTILE_SITE_KEY=
